# TIRA App Configuration
# Copy this file to .env and adjust values

# Server port (default: 5000)
PORT=5000

# Node environment
NODE_ENV=production

# AI API Keys (for report generation)
# Set at least one to enable AI report generation
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
DEEPSEEK_API_KEY=sk-...your-key-here...
OPENAI_API_KEY=sk-...your-key-here...
OPENROUTER_API_KEY=sk-or-...your-key-here...

# AI Model names (configurable)
ANTHROPIC_MODEL=claude-haiku-4-5
DEEPSEEK_MODEL=deepseek-reasoner
OPENAI_MODEL=gpt-4o-mini

# OpenRouter: 4 model slots (https://openrouter.ai/models)
OPENROUTER_MODEL1=qwen/qwen3.6-plus
OPENROUTER_MODEL2=minimax/minimax-m2.5
OPENROUTER_MODEL3=moonshotai/kimi-k2.5
OPENROUTER_MODEL4=openrouter/auto
# Optional: HTTP Referer dùng cho OpenRouter analytics
# OPENROUTER_REFERER=https://tira.gpt4vn.com

# PostgreSQL Database — STRONGLY RECOMMENDED for production (Coolify, etc.)
#   - If set, history (reports / analyses / deep-company) persists in Postgres
#     and SURVIVES container redeploy/restart.
#   - If unset, app falls back to data/*.json files (lost on container rebuild).
#   - Add ?sslmode=require to URL if your Postgres requires SSL, or set DATABASE_SSL=true.
DATABASE_URL=postgresql://tira:tira_secret_2024@postgres:5432/tira_db
# DATABASE_SSL=true     # uncomment if cloud Postgres needs SSL and URL doesn't include sslmode

# PostgreSQL container settings (for docker-compose)
POSTGRES_USER=tira
POSTGRES_PASSWORD=tira_secret_2024
POSTGRES_DB=tira_db
POSTGRES_PORT=5432
